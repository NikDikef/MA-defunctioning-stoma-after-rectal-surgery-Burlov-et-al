          random = T,
          prediction = T,
          method.random.ci = "HK",
          method.predict = "HTS")

funnel(m.prop.sub150,
       studlab = F, 
       xlim = c(-5,0), 
       ylim = c(0.7, 0), 
       main = "Studies with n ≥ 150")
```

\
The "All studies" plot shows visible asymmetry, but Peters' test does not confirm it as statistically significant (p `r p_peters_all <- metabias(m.prop, method.bias = "peters")$p.value; ifelse(p_peters_all < 0.001, "< 0.001", paste0("= ", round(p_peters_all, 3)))`). Restricting the analysis to studies with a sample size of at least 150 (k = `r m.prop.sub150$k`) does not change this conclusion (p `r p_peters_150 <- metabias(m.prop.sub150, method.bias = "peters")$p.value; ifelse(p_peters_150 < 0.001, "< 0.001", paste0("= ", round(p_peters_150, 3)))`).

\
Figure 9. Funnel plot with Trim-and-fill method.
```{r}
#| label: 14-funnel-trimfill
#| fig-width: 6
#| fig-height: 5

par(mfrow = c(1,1))

m.prop.trim <- trimfill(m.prop)

trimfill(m.prop) |> 
 funnel(studlab = F, 
       xlim = c(-5,0), 
       ylim = c(0.7, 0))

legend("topleft",
       legend = c("Observed studies",
                  "Imputed studies"),
       pch = 21,
       pt.bg = c("grey65", "white"),
       col = "black",
       pt.cex = 1.2,
       cex = 1,
       bty = "n",
       inset = 0.02)
```

\
As a sensitivity analysis, the Duval & Tweedie trim-and-fill method was applied to impute studies that would restore funnel-plot symmetry, providing an estimate of the pooled effect if the visually observed (but not statistically confirmed) asymmetry were driven by publication bias. The funnel plot shows the effect that the imputed studies (n = 25) would need to have.

\
As part of the sensitivity analysis, we decided to supplement the GLMM results with those from the inverse-variance method and the Duval & Tweedie trim-and-fill method, to assess the robustness of the findings.

\
Table 2. Comparison of several methods for estimating the pooled effect.
```{r}
#| label: 15-method-comparison

m.prop.IV <- df |> 
 filter_out(is.na(`Anastomotic leak`)) |> 
 mutate(`Publication Year` = factor(ifelse(`Publication Year` < 2010, "<2010",
                                    ifelse(`Publication Year` >= 2020, "≥2020", "2010-2019")),
                                    levels = c("<2010", "2010-2019", "≥2020"))) |> 
 metaprop(event = `Anastomotic leak`,
          n = N,
          studlab = Author_year,
          data = _,
          method = "Inverse",
          sm = "PLOGIT",
          common = F,
          random = T,
          prediction = T,
          method.random.ci = "HK",
          method.predict = "HTS")

to_percent <- function(x) 100 * plogis(x)

tibble(Model = c("GLMM", "IV", "Trim-and-fill method"),
       Estimate = c(to_percent(m.prop$TE.random), to_percent(m.prop.IV$TE.random),
                    to_percent(m.prop.trim$TE.random)),
       CI_lower = c(to_percent(m.prop$lower.random), to_percent(m.prop.IV$lower.random),
                    to_percent(m.prop.trim$lower.random)),
       CI_upper = c(to_percent(m.prop$upper.random), to_percent(m.prop.IV$upper.random),
                    to_percent(m.prop.trim$upper.random)),
       PI_lower = c(to_percent(m.prop$lower.predict), to_percent(m.prop.IV$lower.predict),
                    to_percent(m.prop.trim$lower.predict)),
       PI_upper = c(to_percent(m.prop$upper.predict), to_percent(m.prop.IV$upper.predict),
                    to_percent(m.prop.trim$upper.predict))
) |>
  mutate(`Pooled proportion\n(95% CI)` = sprintf("%.2f%% (%.2f; %.2f)",
                                              Estimate, CI_lower, CI_upper),
         `95% prediction interval` = sprintf("%.2f%%; %.2f%%", PI_lower, PI_upper)) |>
  select(Model,
         `Pooled proportion\n(95% CI)`,
         `95% prediction interval`) |> 
 tab_ME() |> 
 align(j = 2:3, align = "center", part = "all")
```
GLMM -- generalized linear mixed-effects model, IV -- inverse-variance, Trim-and-fill method -- Duval & Tweedie trim and fill method.

\
Results of the GLMM and IV methods are similar. However, the estimate recovered by the Duval & Tweedie trim-and-fill method suggests that the risk of anastomotic leak may be higher, based on the prediction interval.

