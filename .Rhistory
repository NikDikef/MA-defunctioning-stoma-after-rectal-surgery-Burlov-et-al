library(tidyverse)
library(metafor)
library(meta)
library(dmetar)
library(gtsummary)
library(flextable)
df <- readxl::read_excel("Data/Original/df.xlsx") |>
mutate(Author_year = paste0(`First Author`, ", ", `Publication Year`, " ", ifelse(is.na(`Дубли`), "", `Дубли`)),
Стома = replace_values(Стома,
"смешанная" ~ "ileo + colo",
"илео" ~ "ileo",
"коло" ~ "colo"),
Дизайн = factor(replace_values(Дизайн,
"РКИ" ~ "RCT",
"ПК" ~ "Prospective cohort",
"РК" ~ "Retrospective cohort"),
levels = c("Retrospective cohort", "Prospective cohort", "RCT")),
Когорта = replace_values(Когорта,
"Общая" ~ "Part of study",
"Стома" ~ "Full study")) |>
rename(Stomy = Стома,
Design = Дизайн,
`Localisation of data` = Когорта,
`N sample` = `Общая когорта`,
Male = Мужчины,
Age = Возраст,
BMI = ИМТ,
LOS = Койки,
`NACh(R)Th` = НАХЛТ,
Complications = Осложнения,
`Severe complications` = Тяжелые,
`Anastomotic leak` = Несостоятельность,
Infection = Инфекции,
Mortality = Смерть
)
tab_tbl <- function(tbl){
as_flex_table(tbl) |>
theme_box() |>
autofit() |>
fit_to_width(8) |>
font(fontname = "Times New Roman", part = "all") |>
fontsize(size = 12, part = "all")
}
tab_ME <- function(ME){
flextable(ME) |>
theme_box() |>
autofit() |>
fit_to_width(8) |>
font(fontname = "Times New Roman", part = "all") |>
fontsize(size = 12, part = "all")
}
theme_public <- function() {
theme_bw(base_size = 16) +
theme(strip.background = element_rect(fill = "grey95"))
}
theme_set(theme_public())
#| fig-width: 9
#| fig-height: 16
m.prop <- df |>
filter_out(is.na(`Anastomotic leak`)) |>
mutate(`Publication Year` = factor(ifelse(`Publication Year` < 2010, "<2010",
ifelse(`Publication Year` >= 2020, "≥2020", "2010-2019")),
levels = c("<2010", "2010-2019", "≥2020"))) |>
metaprop(event = `Anastomotic leak`,
n = N,
studlab = Author_year,
data = _,
method = "GLMM",
sm = "PLOGIT",
common = F,
random = T,
prediction = T,
method.random.ci = "HK",
method.predict = "HTS")
forest(m.prop,
common = F,
random = T,
overall = T,
prediction = T,
pooled.totals = T,
pooled.events = T,
backtransf = T,
print.I2.ci = T,
print.tau2.ci = F,
pscale = 100,
xlim = c(0, 30),
at = seq(0, 30, 5),
smlab = "",
xlab = "Anastomotic leak, %",
leftcols = c("studlab", "n", "event"),
leftlabs = c("Author, Year (subset)", "N sample", "Events"),
rightcols = c("effect", "ci"),
rightlabs = c("Proportion, %", "95% CI"),
digits = 2,
fontsize = 10,
spacing = 1,
col.square = "grey75",
col.diamond.random = "blue",
col.predict = "red"
)
metabias(m.prop, method.bias = "peters")
library(meta)
# Egger's test (already used in doc)
print(metabias(m.prop, method.bias = "linreg"))
tryCatch({
print(metabias(m.prop, method.bias = "Peters"))
}, error = function(e) cat("ERROR:", conditionMessage(e), "\n"))
m.sub150 <- df |>
filter_out(is.na(`Anastomotic leak`)) |>
filter_out(N < 150) |>
metaprop(event = `Anastomotic leak`, n = N, studlab = Author_year, data = _,
method = "GLMM", sm = "PLOGIT", common = F, random = T, prediction = T,
method.random.ci = "HK", method.predict = "HTS")
cat("k =", m.sub150$k, "\n")
print(metabias(m.sub150, method.bias = "peters"))
cat("class:", class(m.prop), "\n")
cat("df.random:", m.prop$df.random, "\n")
cat("k:", m.prop$k, "\n")
cat("method.random.ci:", m.prop$method.random.ci, "\n")
# check TE.random computation object attributes for test type
str(m.prop[c("df.random","seTE.classic","seTE.random","zval.random","statistic.random")], max.level=1)
tools::Rd2txt(utils:::.getHelpFile(help(metaprop, package = "meta")))
