to_percent(m.prop.trim$upper.random)),
PI_lower = c(to_percent(m.prop$lower.predict), to_percent(m.prop.IV$lower.predict),
to_percent(m.prop.trim$lower.predict)),
PI_upper = c(to_percent(m.prop$upper.predict), to_percent(m.prop.IV$upper.predict),
to_percent(m.prop.trim$upper.predict))
) |>
mutate(`Pooled proportion (95% CI)` = sprintf("%.2f%% (%.2f–%.2f)",
Estimate, CI_lower, CI_upper),
`95% prediction interval` = sprintf("%.2f%%–%.2f%%", PI_lower, PI_upper)) |>
select(Model,
`Pooled proportion (95% CI)`,
