label = list(Design = "Design of study",
`Localisation of data` = "Data availability",
`N sample` = "Size sample of study",
Male = "Male rate",
`NACh(R)Th` = "NACh(R)Th rate",
Complications = "Complications rate",
`Severe complications` = "Severe complications rate",
`Anastomotic leak` = "Anastomotic leak rate",
Infection = "Infection rate",
Death = "Death rate"
),
type = list(c(all_continuous(), Death) ~ "continuous2"),
statistic = list(c(Male, Age,
BMI, LOS) ~ c("{mean} ({sd})",
"{median} [{p25}, {p75}]",
"{min} - {max}"),
c(`N sample`, `NACh(R)Th`, `Complications`,
`Severe complications`, `Anastomotic leak`,
Infection, Death) ~ c("{median} [{p25}, {p75}]",
"{min} - {max}")),
missing_text = "Missing") |>
modify_footnote("stat_0" ~ NA) |>
modify_table_body( ~ .x |>
mutate(
label = case_when(row_type == "label" &
var_type %in% c("categorical", "dichotomous") ~ paste0(label, "*"),
row_type == "label" &
var_type %in% c("continuous", "continuous2") ~ paste0(label, "^"),
TRUE ~ label)))
